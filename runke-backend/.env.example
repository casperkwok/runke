# 复制为 .env 并按需修改。.env 不入库（见 .gitignore）。
APP_NAME=Runke
ENV=dev
DEBUG=true

# PostgreSQL (asyncpg DSN)。本地直连用 localhost；docker compose 内由 compose 注入 postgres 主机名。
DATABASE_URL=postgresql+asyncpg://runke:runke@localhost:5432/runke
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT —— 生产务必改成强随机值
JWT_SECRET=change-me-in-env
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14

# CORS（前端来源），逗号或 JSON 数组
CORS_ORIGINS=["http://localhost:3000"]

# LLM —— DeepSeek（OpenAI 兼容）。在 https://platform.deepseek.com 申请 key。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 当前型号：deepseek-v4-flash（快/默认）或 deepseek-v4-pro（更强）
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3

# RAG embedding —— fastembed（ONNX，无需 torch，首次用会自动下载模型）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
RAG_TOP_K=4
